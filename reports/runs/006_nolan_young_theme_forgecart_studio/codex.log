  background: linear-gradient(180deg, #ffffff 0%, var(--color-bg-soft) 100%);
}

.hero__grid,
.brand-statement,
.single-service-highlight,
.business-solution {
  display: grid;
  gap: clamp(1.5rem, 4vw, 4rem);
  align-items: center;
}

.hero__summary,
.trust-row,
.stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: .8rem;
  margin-top: 1.5rem;
}

.hero__summary > *,
.trust-row > *,
.stats-row > * {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: #fff;
  padding: 1rem;
}

.media-frame,
.forgecart-image {
  display: block;
  width: 100%;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  background: var(--color-bg-soft);
  box-shadow: var(--shadow);
}

.card-grid,
.portfolio-grid,
.blog-grid,
.footer-widgets {
  display: grid;
  gap: 1rem;
}

.card-grid--three,
.service-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.info-card,
.service-card,
.portfolio-card,
.blog-card,
.work-card,
.article-card,
.package-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: #fff;
  padding: clamp(1rem, 2vw, 1.4rem);
  box-shadow: 0 8px 26px rgba(15, 23, 42, .06);
}

.info-card img,
.service-card img,
.portfolio-card img,
.blog-card img,
.work-card img,
.article-card img {
  width: 100%;
  margin-bottom: 1rem;
  border-radius: var(--radius);
}

.featured-work-strip {
  background: var(--color-dark);
  color: #fff;
}

.featured-work-strip a {
  color: #fff;
}

.process-list {
  display: grid;
  gap: 1rem;
  counter-reset: process;
}

.process-list > * {
  position: relative;
  border-left: 3px solid var(--color-secondary);
