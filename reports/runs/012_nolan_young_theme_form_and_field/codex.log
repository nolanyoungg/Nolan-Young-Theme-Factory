t: space-between; gap: 1rem; }\r\n.site-footer__legal nav { display: flex; gap: 1rem; }\r\n@media (min-width: 760px) { .footer-widgets { grid-template-columns: 2fr 1fr 1fr 1.3fr 1.4fr; } }\r\n.site-footer {\r\n  background: var(--color-dark);\r\n  color: #fff;\r\n}\r\n\r\n.site-footer__inner {\r\n  width: min(100% - 2rem, var(--container));\r\n  margin-inline: auto;\r\n  padding-block: 3rem 1.25rem;\r\n}\r\n\r\n.footer-cta {\r\n  background: var(--color-primary);\r\n  color: #fff;\r\n  padding: clamp(2rem, 5vw, 4rem) 1rem;\r\n}\r\n\r\n.footer-widgets {\r\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\r\n  align-items: start;\r\n}\r\n\r\n.footer-brand {\r\n  grid-column: span 2;\r\n  max-width: 420px;\r\n}\r\n\r\n.site-footer h2,\r\n.site-footer h3,\r\n.site-footer p {\r\n  color: #fff;\r\n}\r\n\r\n.site-footer p,\r\n.site-footer li {\r\n  color: rgba(255, 255, 255, .72);\r\n}\r\n\r\n.site-footer nav {\r\n  display: grid;\r\n  gap: .5rem;\r\n}\r\n\r\n.site-footer a {\r\n  color: rgba(255, 255, 255, .86);\r\n  text-decoration: none;\r\n}\r\n\r\n.site-footer a:hover {\r\n  color: #fff;\r\n  text-decoration: underline;\r\n}\r\n\r\n.site-footer__legal {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  margin-top: 2rem;\r\n  padding-top: 1.25rem;\r\n  border-top: 1px solid rgba(255, 255, 255, .16);\r\n}\r\n","src/scss/layout/_sections.scss":".hero { padding: clamp(4rem, 9vw, 8rem) 0; background: linear-gradient(180deg, #fff, var(--color-bg-soft)); }\r\n.hero__grid { display: grid; gap: 2rem; align-items: center; }\r\n.hero__visual img { border-radius: var(--radius-lg); box-shadow: var(--shadow); }\r\n.trust-row { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }\r\n.trust-row li { border: 1px solid var(--color-border); background: #fff; border-radius: 999px; padding: .45rem .75rem; font-weight: 800; }\r\n.section-heading { max-width: 850px; margin-bottom: 2rem