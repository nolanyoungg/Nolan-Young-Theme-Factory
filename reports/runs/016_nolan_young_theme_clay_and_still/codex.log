+<?php
+/** Local, compiled Clay & Still assets. */
+if ( ! defined( 'ABSPATH' ) ) { exit; }
+function clay_still_enqueue() {
+	$css = 'assets/css/bundle.css';
+	$js = 'assets/js/bundle.js';
