 .portfolio-card img,
 .blog-card img,
-.work-card img,
-.article-card img {
+.featured-strip img,
+.featured-article img {
   width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: var(--radius);
   margin-bottom: 1rem;
+  background: var(--color-bg-soft);
+}
+
+.service-card a,
+.blog-card a,
+.portfolio-card a,
+.featured-strip a {
+  text-decoration: none;
+}
+
+.service-card:hover,
+.blog-card:hover,
+.portfolio-card:hover {
+  border-color: var(--color-border-strong);
+  box-shadow: var(--shadow);
+}
+
+.service-selector__layout {
+  display: grid;
