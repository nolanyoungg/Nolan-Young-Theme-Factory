-header-height); width: min(100% - 2rem, var(--container)); margin-inline: auto; display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; }\r\n.site-branding { display: inline-flex; align-items: center; gap: .75rem; text-decoration: none; min-width: max-content; }\r\n.brand-mark { width: 42px; height: 42px; flex: 0 0 42px; }\r\n.site-branding__text { display: grid; line-height: 1.1; }\r\n.site-branding__name { font-weight: 900; font-size: 1.05rem; }\r\n.site-branding__tagline { color: var(--color-muted); font-size: .78rem; }\r\n.primary-navigation { display: none; justify-content: center; gap: .35rem; }\r\n.nav-trigger, .nav-link { border: 0; background: transparent; color: var(--color-text); text-decoration: none; padding: .75rem .9rem; border-radius: var(--radius); font-weight: 800; cursor: pointer; }\r\n.nav-trigger:hover, .nav-link:hover, .nav-trigger[aria-expanded=\"true\"] { background: var(--color-bg-soft); }\r\n.mobile-menu-toggle { justify-self: end; width: 46px; height: 46px; border: 1px solid var(--color-border); border-radius: var(--radius); background: #fff; display: grid; place-content: center; gap: 4px; }\r\n.mobile-menu-toggle span:not(.screen-reader-text) { width: 20px; height: 2px; background: var(--color-text); display: block; }\r\n.btn-header-cta { display: none; }\r\n.menu-backdrop { position: fixed; inset: 0; z-index: 40; background: rgba(15, 23, 42, .44); }\r\n.nolan-menu { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); z-index: 60; width: min(100% - 2rem, 1080px); background: #fff; border: 1px solid var(--color-border); border-radius: 0 0 var(--radius-lg) var(--radius-lg); box-shadow: var(--shadow); padding: 1rem; }\r\n.nolan-menu__inner { display: grid; grid-template-columns: 240px 1fr; gap: 1.25rem; }\r\n.nolan-menu__rail { display: grid; align-content: start; gap: .35rem; border-right: 1px solid var(--color-border); padding-right: 1rem; }\r\n.nolan-menu__rail button { text-align: left; border: 0; border-radius: var(--radius); background: transparent; padding: .85rem; font-weight: 800; cursor: pointer; }\r\n.nolan-menu__rail button.is-active, .nolan-menu__rail button:hover { background: var(--color-bg-soft); color: var(--color-primary); }\r\n.nolan-menu__content section { grid-template-columns: 280px 1fr; gap: 1.25rem; align-items: center; }\r\n.nolan-menu__content section.is-active { display: grid; }\r\n.nolan-menu__content img, .nolan-menu__blog-grid img { border-radius: var(--radius); background: var(--color-bg-soft); }\r\n.nolan-menu__blog-grid { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); }\r\n.mobile-drawer { position: fixed; inset: 0 0 0 auto; width: min(92vw, 420px); z-index: 70; background: #fff; box-shadow: var(--shadow); padding: 1rem; overflow-y: auto; }\r\n.mobile-drawer__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }\r\n.mobile-drawer__close { border: 1px solid var(--color-border); background: #fff; border-radius: var(--radius); padding: .55rem .8rem; }\r\n.mobile-drawer nav, .mobile-accordion div { display: grid; gap: .5rem; }\r\n.mobile-drawer nav > a, .mobile-accordion > button, .mobile-accordion div a { text-decoration: none; border: 0; border-radius: var(--radius); background: var(--color-bg-soft); padding: .9rem 1rem; color: var(--color-text); text-align: left; font-weight: 800; }\r\n@media (min-width: 960px) { .primary-navigation { display: flex; } .mobile-menu-toggle { display: none; } .btn-header-cta { display: inline-flex; } }\r\n","src/scss/pages/_work.scss":".work-grid { display: grid; gap: 20px; }\r\n","src/scss/base/_accessibility.scss":".screen-reader-text { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\r\n.screen-reader-text:focus { clip: auto; width: auto; height: auto; z-index: 100000; background: #fff; color: #000; padding: .75rem 1rem; }\r\n:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }\r\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; } }\r\n","src/scss/components/_buttons.scss":".btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border-radius: var(--radius); border: 1px solid transparent; padding: .78rem 1.1rem; font-weight: 800; text-decoration: none; cursor: pointer; transition: background var(--transition), border-color var(--transition), transform var(--transition); }\r\n.btn:hover { transform: translateY(-1px); }\r\n.btn:active { transform: translateY(0); }\r\n.btn[disabled], .btn.is-disabled { opacity: .55; pointer-events: none; }\r\n.btn-primary, .btn-header-cta { background: var(--color-primary); color: #fff; }\r\n.btn-primary:hover, .btn-header-cta:hover { background: var(--color-primary-hover); color: #fff; }\r\n.btn-secondary { background: #fff; color: var(--color-text); border-color: var(--color-border-strong); }\r\n.btn-secondary:hover { background: var(--color-bg-soft); color: var(--color-text); }\r\n.btn-small { min-height: 38px; padding: .55rem .8rem; font-size: .9rem; }\r\n.btn-full { width: 100%; }\r\n.btn-text { padding-inline: 0; min-height: 34px; background: transparent; color: var(--color-primary); border: 0; }\r\n.button-row { display: flex; flex-wrap: wrap; gap: .85rem; align-items: center; }\r\n","src/scss/pages/_services.scss":".services-grid { display: grid; gap: 20px; }\r\n","src/scss/abstracts/_variables.scss":":root {\r\n  --color-bg: #ffffff;\r\n  --color-bg-soft: #f4f7fb;\r\n  --color-dark: #101827;\r\n  --color-primary: #2563eb;\r\n  --color-primary-hover: #1d4ed8;\r\n  --color-secondary: #14b8a6;\r\n  --color-accent: #f97316;\r\n  --color-text: #111827;\r\n  --color-muted: #64748b;\r\n  --color-border: #e2e8f0;\r\n  --color-border-strong: #cbd5e1;\r\n  --font-base: \"Avenir Next\", \"Segoe UI\", Helvetica, Arial, sans-serif;\r\n  --container: 1180px;\r\n  --container-narrow: 780px;\r\n  --header-height: 84px;\r\n  --radius: 8px;\r\n  --radius-lg: 18px;\r\n  --shadow: 0 18px 50px rgba(15, 23, 42, .12);\r\n  --transition: 180ms ease;\r\n}\r\n","src/scss/components/_accordion.scss":".accordion-item { border-bottom: 1px solid var(--color-border); }\r\n.accordion-item > button { width: 100%; border: 0; background: #fff; padding: 1.15rem 0; text-align: left; font-weight: 900; font-size: 1.05rem; cursor: pointer; }\r\n.accordion-item > button::after { content: \"+\"; float: right; color: var(--color-primary); }\r\n.accordion-item > button[aria-expanded=\"true\"]::after { content: \"-\"; }\r\n.accordion-item > div { padding-bottom: 1.2rem; }\r\n.accordion-item {\r\n  border-bottom: 1px solid var(--color-border);\r\n}\r\n\r\n.accordion-item > button {\r\n  width: 100%;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--color-text);\r\n  padding: 1.15rem 0;\r\n  text-align: left;\r\n  font-weight: 900;\r\n  cursor: pointer;\r\n}\r\n\r\n.accordion-item > button::after {\r\n  content: \"+\";\r\n  color: var(--color-primary);\r\n}\r\n\r\n.accordion-item > button[aria-expanded=\"true\"]::after {\r\n  content: \"-\";\r\n}\r\n\r\n.accordion-item > div {\r\n  padding-bottom: 1.15rem;\r\n}\r\n","src/scss/base/_typography.scss":"body { font-size: 16px; line-height: 1.65; }\r\nh1, h2, h3, h4 { line-height: 1.08; margin: 0 0 1rem; letter-spacing: 0; }\r\nh1 { font-size: clamp(2.5rem, 7vw, 5.8rem); max-width: 12ch; }\r\nh2 { font-size: clamp(2rem, 4vw, 3.65rem); }\r\nh3 { font-size: clamp(1.25rem, 2vw, 1.65rem); }\r\np { margin: 0 0 1rem; color: var(--color-muted); }\r\n.eyebrow { color: var(--color-primary); font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }\r\n.section-dark .eyebrow, .site-footer .eyebrow { color: #93c5f