}

.section-heading {
  max-width: 760px;
  margin-bottom: clamp(1.5rem, 4vw, 3rem);
}

.center {
  text-align: center;
}

.split {
  display: grid;
  gap: clamp(1.5rem, 4vw, 4rem);
  align-items: center;
}

.section-dark {
  background: var(--color-dark);
  color: #fff;
}

.section-dark p,
.section-dark dd,
.section-dark li {
  color: rgba(255, 255, 255, .78);
}

.eyebrow {
  margin: 0 0 .7rem;
  color: var(--color-secondary);
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.hero {
