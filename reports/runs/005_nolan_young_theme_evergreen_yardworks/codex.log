+    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
+  }
+}
+
+@media (max-width: 760px) {
+  .container,
+  .template-container,
+  .container.narrow,
+  .narrow {
+    width: min(100% - 1rem, var(--container));
+  }
+
+  .section,
+  .template-section {
+    padding-block: 3rem;
+  }
+
+  .hero {
+    min-height: auto;
+    padding-block: 1.5rem 2rem;
+  }
+
+  .hero__grid {
+    grid-template-columns: 1fr;
+    gap: 1rem;
+  }
+
+  .hero__copy {
+    min-width: 0;
+    max-width: 100%;
+  }
+
+  .hero__copy > p:not(.eyebrow) {
+    max-width: 100%;
+    overflow-wrap: break-word;
+  }
+
+  .hero__visual img {
+    max-height: 34svh;
+    aspect-ratio: 16 / 10;
+  }
+
+  .button-row {
+    display: grid;
+    grid-template-columns: 1fr;
+  }
+
+  .button-row .btn {
+    width: 100%;
+    max-width: 100%;
+    white-space: normal;
+  }
+
+  .trust-row {
+    display: grid;
+    grid-template-columns: 1fr;
   }
 
-  .comparison-grid {
-    grid-template-columns: repeat(2, 1fr);
+  .quick-trust__grid {
+    grid-template-columns: 1fr 1fr;
   }
 
-  .portfolio-grid,
-  .blog-grid {
-    grid-template-columns: repeat(3, 1fr);
+  .section-heading--row {
+    display: grid;
   }
 }
+
+@media (max-width: 430px) {
+  .quick-trust__grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-reveal] {
+    transform: none;
+    opacity: 1;
+    transition: none;
+  }
+}
+
