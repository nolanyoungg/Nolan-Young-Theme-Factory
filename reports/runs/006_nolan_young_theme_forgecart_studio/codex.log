+}
+
+.brand-mark {
+  width: 42px;
+  height: 42px;
+  flex: 0 0 42px;
+}
+
+.site-branding__text {
+  display: grid;
+  min-width: 0;
+  line-height: 1.1;
+}
+
+.site-branding__name {
+  font-size: 1rem;
+  font-weight: 900;
+}
+
+.site-branding__tagline {
