{ margin: 0; overflow-x: hidden; background: var(--color-bg); color: var(--color-text); font-family: var(--font-base); }\r\nimg, svg { max-width: 100%; height: auto; display: block; }\r\na { color: inherit; }\r\nbutton, input, textarea { font: inherit; }\r\n.is-scroll-locked { overflow: hidden; }\r\n[hidden] { display: none !important; }\r\n*,\r\n*::before,\r\n*::after {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  scroll-behavior: smooth;\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  min-width: 320px;\r\n  background: var(--color-bg);\r\n  color: var(--color-text);\r\n  font-family: var(--font-base);\r\n}\r\n\r\nimg,\r\nsvg,\r\nvideo {\r\n  max-width: 100%;\r\n  height: auto;\r\n}\r\n\r\nbutton,\r\ninput,\r\ntextarea,\r\nselect {\r\n  font: inherit;\r\n}\r\n\r\na {\r\n  color: var(--color-primary);\r\n}\r\n\r\n[hidden] {\r\n  display: none !important;\r\n}\r\n\r\n.is-scroll-locked {\r\n  overflow: hidden;\r\n}\r\n"},{"path":"src/scss/base/_typography.scss","content":"body { font-size: 16px; line-height: 1.65; }\r\nh1, h2, h3, h4 { line-height: 1.08; margin: 0 0 1rem; letter-spacing: 0; }\r\nh1 { font-size: clamp(2.5rem, 7vw, 5.8rem); max-width: 12ch; }\r\nh2 { font-size: clamp(2rem, 4vw, 3.65rem); }\r\nh3 { font-size: clamp(1.25rem, 2vw, 1.65rem); }\r\np { margin: 0 0 1rem; color: var(--color-muted); }\r\n.eyebrow { color: var(--color-primary); font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }\r\n.section-dark .eyebrow, .site-footer .eyebrow { color: #93c5fd; }\r\n.section-dark, .section-dark p, .section-dark a { color: #fff; }\r\nbody {\r\n  font-size: 1rem;\r\n  line-height: 1.65;\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4 {\r\n  margin: 0 0 .75rem;\r\n  color: inherit;\r\n  font-weight: 900;\r\n  line-height: 1.08;\r\n}\r\n\r\nh1 {\r\n  font-size: clamp(2.5rem, 7vw, 5.8rem);\r\n  max-width: 980px;\r\n}\r\n\r\nh2 {\r\n  font-size: clamp(2rem, 4vw, 3.6rem);\r\n}\r\n\r\nh3 {\r\n  font-size: clamp(1.25rem, 2vw, 1.65rem);\r\n}\r\n\r\np {\r\n  margin: 0 0 1rem;\r\n  color: var(--color-muted);\r\n}\r\n\r\nul,\r\nol {\r\n  padding-left: 1.2rem;\r\n}\r\n\r\n.site-main a:not(.btn):focus-visible,\r\n.site-footer a:focus-visible,\r\nbutton:focus-visible,\r\ninput:focus-visible,\r\ntextarea:focus-visible,\r\nselect:focus-visible {\r\n  outline: 3px solid var(--color-accent);\r\n  outline-offset: 3px;\r\n}\r\n"},{"path":"src/scss/base/_accessibility.scss","content":".screen-reader-text { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\r\n.screen-reader-text:focus { clip: auto; width: auto; height: auto; z-index: 100000; background: #fff; color: #000; padding: .75rem 1rem; }\r\n:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }\r\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; } }\r\n"},{"path":"src/scss/base/_forms.scss","content":".northstar-form, .newsletter-form, .search-form { display: grid; gap: 1rem; }\r\nlabel { display: grid; gap: .4rem; font-weight: 800; color: var(--color-text); }\r\ninput, textarea { width: 100%; border: 1px solid var(--color-border-strong); border-radius: var(--radius); padding: .82rem .9rem; background: #fff; color: var(--color-text); }\r\ntextarea { resize: vertical; }\r\n.form-note, .field-error { font-size: .9rem; }\r\n.field-error { color: #b42318; margin: .2rem 0 0; }\r\n.form-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }\r\n.search-form,\r\n.northstar-form,\r\n.newsletter-form {\r\n  display: grid;\r\n  gap: .85rem;\r\n}\r\n\r\n.search-form {\r\n  grid-template-columns: 1fr auto;\r\n}\r\n\r\nlabel {\r\n  display: grid;\r\n  gap: .35rem;\r\n  color: var(--color-text);\r\n  font-weight: 800;\r\n}\r\n\r\ninput,\r\ntextarea,\r\nselect {\r\n  width: 100%;\r\n  border: 1px solid var(--color-border-strong);\r\n  border-radius: var(--radius);\r\n  background: #fff;\r\n  color: var(--color-text);\r\n  padding: .82rem .9rem;\r\n}\r\n\r\ntextarea {\r\n  min-height: 150px;\r\n  resize: vertical;\r\n}\r\n\r\n.field-error,\r\n.form-status--error {\r\n  color: #9a3412;\r\n  font-weight: 800;\r\n}\r\n\r\n.form-status--success {\r\n  color: #0f766e;\r\n  font-weight: 800;\r\n}\r\n\r\n.honeypot,\r\n.visually-hidden-field {\r\n  position: absolute;\r\n  left: -10000px;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n}\r\n"},{"path":"src/scss/layout/_container.scss","content":".container, .template-container { width: min(100% - 2rem, var(--container)); margin-inline: auto; }\r\n.narrow { width: min(100% - 2rem, var(--container-narrow)); }\r\n.section, .template-section { padding: clamp(4rem, 8vw, 7rem) 0; }\r\n.section-dark { background: var(--color-dark); }\r\n.center { text-align: center; }\r\n.center h2, .center p { margin-inline: auto; }\r\n.split { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; }\r\n@media (min-width: 820px) { .split { grid-template-columns: 1fr 1fr; } }\r\n"},{"path":"src/scss/layout/_header.scss","content":".site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); border-bottom: 1px solid transparent; transition: border-color var(--transition), box-shadow var(--transition); }\r\n.site-header.is-scrolled { border-color: var(--color-border); box-shadow: 0 10px 28px rgba(15,23,42,.08); }\r\n.site-header__inner { min-height: var(--header-height); width: min(100% - 2rem, var(--container)); margin-inline: auto; display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; }\r\n.site-branding { display: inline-flex; align-items: center; gap: .75rem; text-decoration: none; min-width: max-content; }\r\n.brand-mark { width: 42px; height: 42px; flex: 0 0 42px; }\r\n.site-branding__text { display: grid; line-height: 1.1; }\r\n.site-branding__name { font-weight: 900; font-size: 1.05rem; }\r\n.site-branding__tagline { color: var(--color-muted); font-size: .78rem; }\r\n.primary-navigation { display: none; justify-content: center; gap: .35rem; }\r\n.nav-trigger, .nav-link { border: 0; background: transparent; color: var(--color-text); text-decoration: none; padding: .75rem .9rem; border-radius: var(--radius); font-weight: 800; cursor: pointer; }\r\n.nav-trigger:hover, .nav-link:hover, .nav-trigger[aria-expanded=\"true\"] { background: var(--color-bg-soft); }\r\n.mobile-menu-toggle { justify-self: end; width: 46px; height: 46px; border: 1px solid var(--color-border); border-radius: var(--radius); background: #fff; display: grid; place-content: center; gap: 4px; }\r\n.mobile-menu-toggle span:not(.screen-reader-text) { width: 20px; height: 2px; background: var(--color-text); display: block; }\r\n.btn-header-cta { display: none; }\r\n.menu-backdrop { position: fixed; inset: 0; z-index: 40; background: rgba(15, 23, 42, .44); }\r\n.nolan-menu { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); z-index: 60; width: min(100% - 2rem, 1080px); background: #fff; border: 1px solid var(--color-border); border-radius: 0 0 var(--radius-lg) var(--radius-lg); box-shadow: var(--shadow); padding: 1rem; }\r\n.nolan-menu__inner { display: grid; grid-template-columns: 240px 1fr; gap: 1.25rem; }\r\n.nolan-menu__rail { display: grid; align-content: start; gap: .35rem; border-right: 1px solid var(--color-border); padding-right: 1rem; }\r\n.nolan-menu__rail button { text-align: left; border: 0; border-radius: var(--radius); background: transparent; padding: .85rem; font-weight: 800; cursor: pointer; }\r\n.nolan-menu__rail button.is-active, .nolan-menu__rail button:hover { background: var(--color-bg-soft); color: var(--color-primary); }\r\n.nolan-menu__content section { grid-template-columns: 280px 1fr; gap: 1.25rem; align-items: center; }\r\n.nolan-menu__content section.is-active { display: grid; }\r\n.nolan-menu__content img, .nolan-menu__blog-grid img { border-radius: var(--radius); background: var(--color-bg-soft); }\r\n.nolan-menu__blog-grid { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); }\r\n.mobile-drawer { position: fixed; inset: 0 0 0 auto; width: min(92vw, 420px); z-index: 70; background: #fff; box-shadow: var(--shadow); padding: 1rem; overflow-y: auto; }\r\n.mobile-drawer__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }\r\n.mobile-drawer__close { border: 1px solid var(--color-border); background: #fff; border-radius: var(--radius); padding: .55rem .8rem; }\r\n.mobile-drawer nav, .mobile-accordion div { display: grid; gap: .5rem; }\r\n.mobile-drawer nav > a, .mobile-accordion > button, .mobile-accordion div a { text-decoration: none; border: 0; border-radius: var(--radius); background: var(--color-bg-soft); padding: .9rem 1rem; color: var(--color-text); text-align: left; font-weight: 800; }\r\n@media (min-width: 960px) { .primary-navigation { display: flex; } .mobile-menu-toggle { display: none; } .btn-header-cta { display: inline-flex; } }\r\n"},{"path":"src/scss/layout/_sections.scss","content":".hero { padding: clamp(4rem, 9vw, 8rem) 0; background: linear-gradient(180deg, #fff, var(--color-bg-soft)); }\r\n.hero__grid { display: grid; gap: 2rem; align-items: center; }\r\n.hero__visual img { border-radius: var(--radius-lg); box-shadow: var(--shadow); }\r\n.trust-row { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }\r\n.trust-row li { border: 1px solid var(--color-border); background: #fff; border-radius: 999px; padding: .45rem .75rem; font-weight: 800; }\r\n.section-heading { max-width: 850px; margin-bottom: 2rem; }\r\n.section-heading--row { max-width: none; display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }\r\n.featured-strip { background: #fff; }\r\n.featured-strip__grid, .proof-grid, .process-list { display: grid; gap: 1rem; }\r\n.process-list { list-style: none; counter-reset: step; padding: 0; margin: 0; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }\r\n.process-list li { counter-increment: step; border: 1px solid rgba(226,232,240,.18); border-radius: var(--radius); padding: 1rem; background: rgba(255,255,255,.06); }\r\n.process-list li::before { content: counter(step, decimal-leading-zero); display: block; color: var(--color-secondary); font-weight: 900; }\r\n.process-list span { color: #fff; font-weight: 900; }\r\n.case-study__list { display: grid; gap: .5rem; }\r\n.case-study__list dt { font-weight: 900; color: #fff; }\r\n.proof-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }\r\n.proof-grid > div { padding: 1rem; border-left: 4px solid var(--color-secondary); background: var(--color-bg-soft); border-radius: var(--radius); }\r\n.page-hero { background: var(--color-bg-soft); }\r\n@media (min-width: 900px) { .hero__grid { grid-template-columns: 1fr 1fr; } .featured-strip__grid { grid-template-columns: repeat(3, 1fr); } }\r\n.site-main {\r\n  overflow-x: clip;\r\n}\r\n\r\n.container {\r\n  width: min(100% - 2rem, var(--container));\r\n  margin-inline: auto;\r\n}\r\n\r\n.container.narrow,\r\n.narrow {\r\n  width: min(100% - 2rem, var(--container-narrow));\r\n  margin-inline: auto;\r\n}\r\n\r\n.section {\r\n  padding-block: clamp(3.5rem, 7vw, 7rem);\r\n}\r\n\r\n.section-heading {\r\n  max-width: 760px;\r\n  margin-bottom: clamp(1.5rem, 4vw, 3rem);\r\n}\r\n\r\n.center {\r\n  text-align: center;\r\n}\r\n\r\n.split {\r\n  display: grid;\r\n  gap: clamp(1.5rem, 4vw, 4rem);\r\n  align-items: center;\r\n}\r\n\r\n.section-dark {\r\n  background: var(--color-dark);\r\n  color: #fff;\r\n}\r\n\r\n.section-dark p,\r\n.section-dark dd,\r\n.section-dark li {\r\n  color: rgba(255, 255, 255, .78);\r\n}\r\n\r\n.eyebrow {\r\n  margin: 0 0 .7rem;\r\n  color: var(--color-secondary);\r\n  font-size: .78rem;\r\n  font-weight: 900;\r\n  letter-spacing: .08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.hero {\r\n  padding-block: clamp(4rem, 8vw, 8rem);\r\n  background: linear-gradient(180deg, #ffffff 0%, var(--color-bg-soft) 100%);\r\n}\r\n\r\n.hero__grid,\r\n.brand-statement,\r\n.single-service-highlight,\r\n.business-solution {\r\n  display: grid;\r\n  gap: clamp(1.5rem, 4vw, 4rem);\r\n  align-items: center;\r\n}\r\n\r\n.hero__summary,\r\n.trust-row,\r\n.stats-row {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\r\n  gap: .8rem;\r\n  margin-top: 1.5rem;\r\n}\r\n\r\n.hero__summary > *,\r\n.trust-row > *,\r\n.stats-row > * {\r\n  border: 1px solid var(--color-border);\r\n  border-radius: var(--radius);\r\n  background: #fff;\r\n  padding: 1rem;\r\n}\r\n\r\n.media-frame,\r\n.northstar-image {\r\n  display: block;\r\n  width: 100%;\r\n  border-radius: var(--radius-lg);\r\n  border: 1px solid var(--color-border);\r\n  background: var(--color-bg-soft);\r\n  box-shadow: var(--shadow);\r\n}\r\n\r\n.card-grid,\r\n.portfolio-grid,\r\n.blog-grid,\r\n.footer-widgets {\r\n  display: grid;\r\n  gap: 1rem;\r\n}\r\n\r\n.card-grid--three,\r\n.service-grid {\r\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\r\n}\r\n\r\n.info-card,\r\n.service-card,\r\n.portfolio-card,\r\n.blog-card,\r\n.work-card,\r\n.article-card,\r\n.package-card {\r\n  border: 1px solid var(--color-border);\r\n  border-radius: var(--radius);\r\n  background: #fff;\r\n  padding: clamp(1rem, 2vw, 1.4rem);\r\n  box-shadow: 0 8px 26px rgba(15, 23, 42, .06);\r\n}\r\n\r\n.info-card img,\r\n.service-card img,\r\n.portfolio-card img,\r\n.blog-card img,\r\n.work-card img,\r\n.article-card img {\r\n  width: 100%;\r\n  margin-bottom: 1rem;\r\n  border-radius: var(--radius);\r\n}\r\n\r\n.featured-work-strip {\r\n  background: var(--color-dark);\r\n  color: #fff;\r\n}\r\n\r\n.featured-work-strip a {\r\n  color: #fff;\r\n}\r\n\r\n.process-list {\r\n  display: grid;\r\n  gap: 1rem;\r\n  counter-reset: process;\r\n}\r\n\r\n.process-list > * {\r\n  position: relative;\r\n  border-left: 3px solid var(--color-secondary);\r\n  background: var(--color-bg-soft);\r\n  padding: 1rem 1rem 1rem 1.25rem;\r\n}\r\n\r\n.case-study__list {\r\n  display: grid;\r\n  gap: .75rem;\r\n}\r\n\r\n.case-study__list dt {\r\n  font-weight: 900;\r\n  color: #fff;\r\n}\r\n\r\n.comparison-grid {\r\n  display: grid;\r\n  gap: 1rem;\r\n}\r\n\r\n.comparison-grid article:first-child {\r\n  border-top: 4px solid var(--color-accent);\r\n}\r\n\r\n.comparison-grid article:last-child {\r\n  border-top: 4px solid var(--color-secondary);\r\n}\r\n\r\n.comparison-grid article {\r\n  border-radius: var(--radius);\r\n  border: 1px solid var(--color-border);\r\n  padding: 1.25rem;\r\n  background: #fff;\r\n}\r\n\r\n.faq-section {\r\n  background: var(--color-bg-soft);\r\n}\r\n\r\n.final-cta .container {\r\n  max-width: 820px;\r\n}\r\n\r\n@media (min-width: 760px) {\r\n  .split,\r\n  .hero__grid,\r\n  .brand-statement,\r\n  .single-service-highlight,\r\n  .business-solution {\r\n    grid-template-columns: minmax(0, 1fr) minmax(300px, .9fr);\r\n  }\r\n\r\n  .comparison-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n\r\n  .portfolio-grid,\r\n  .blog-grid {\r\n    grid-template-columns: repeat(3, 1fr);\r\n  }\r\n}\r\n"},{"path":"src/scss/layout/_grid.scss","content":".template-card-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); }\r\n"},{"path":"src/scss/layout/_footer.scss","content":".site-footer { background: var(--color-dark); color: #fff; }\r\n.site-footer p, .site-footer a { color: #dbeafe; }\r\n.footer-cta { background: var(--color-bg-soft); color: var(--color-text); padding: 3rem 0; }\r\n.footer-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }\r\n.footer-cta h2 { max-width: 760px; }\r\n.site-footer__inner { width: min(100% - 2rem, var(--container)); margin-inline: auto; padding: 4rem 0 1.5rem; }\r\n.footer-widgets { display: grid; gap: 2rem; }\r\n.footer-widgets nav, .footer-contact { display: grid; align-content: start; gap: .6rem; }\r\n.footer-widgets h2 { font-size: 1rem; color: #fff; }\r\n.footer-widgets a { text-decoration: none; }\r\n.footer-widgets a:hover { color: #fff; text-decoration: underline; }\r\n.footer-brand { max-width: 360px; }\r\n.site-footer__legal { border-top: 1px solid rgba(226,232,240,.22); margin-top: 3rem; padding-top: 1.25rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }\r\n.site-footer__legal nav { display: flex; gap: 1rem; }\r\n@media (min-width: 760px) { .footer-widgets { grid-template-columns: 2fr 1fr 1fr 1.3fr 1.4fr; } }\r\n.site-footer {\r\n  background: var(--color-dark);\r\n  color: #fff;\r\n}\r\n\r\n.site-footer__inner {\r\n  width: min(100% - 2rem, var(--container));\r\n  margin-inline: auto;\r\n  padding-block: 3rem 1.25rem;\r\n}\r\n\r\n.footer-cta {\r\n  background: var(--color-primary);\r\n  color: #fff;\r\n  padding: clamp(2rem, 5vw, 4rem) 1rem;\r\n}\r\n\r\n.footer-widgets {\r\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\r\n  align-items: start;\r\n}\r\n\r\n.footer-brand {\r\n  grid-column: span 2;\r\n  max-width: 420px;\r\n}\r\n\r\n.site-footer h2,\r\n.site-footer h3,\r\n.site-footer p {\r\n  color: #fff;\r\n}\r\n\r\n.site-footer p,\r\n.site-footer li {\r\n  color: rgba(255, 255, 255, .72);\r\n}\r\n\r\n.site-footer nav {\r\n  display: grid;\r\n  gap: .5rem;\r\n}\r\n\r\n.site-footer a {\r\n  color: rgba(255, 255, 255, .86);\r\n  text-decoration: none;\r\n}\r\n\r\n.site-footer a:hover {\r\n  color: #fff;\r\n  text-decoration: underline;\r\n}\r\n\r\n.site-footer__legal {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  margin-top: 2rem;\r\n  padding-top: 1.25rem;\r\n  border-top: 1px solid rgba(255, 255, 255, .16);\r\n}\r\n"},{"path":"src/scss/components/_buttons.scss","content":".btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border-radius: var(--radius); border: 1px solid transparent; padding: .78rem 1.1rem; font-weight: 800; text-decoration: none; cursor: pointer; transition: background var(--transition), border-color var(--transition), transform var(--transition); }\r\n.btn:hover { transform: translateY(-1px); }\r\n.btn:active { transform: translateY(0); }\r\n.btn[disabled], .btn.is-disabled { opacity: .55; pointer-events: none; }\r\n.btn-primary, .btn-header-cta { background: var(--color-primary); color: #fff; }\r\n.btn-primary:hover, .btn-header-cta:hover { background: var(--color-primary-hover); color: #fff; }\r\n.btn-secondary { background: #fff; color: var(--color-text); border-color: var(--color-border-strong); }\r\n.btn-secondary:hover { background: var(--color-bg-soft); color: var(--color-text); }\r\n.btn-small { min-height: 38px; padding: .55rem .8rem; font-size: .9rem; }\r\n.btn-full { width: 100%; }\r\n.btn-text { padding-inline: 0; min-height: 34px; background: transparent; color: var(--color-primary); border: 0; }\r\n.button-row { display: flex; flex-wrap: wrap; gap: .85rem; align-items: center; }\r\n"},{"path":"src/scss/components/_cards.scss","content":".card-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }\r\n.card-grid--three { grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }\r\n.service-card, .blog-card, .portfolio-card, .info-card, .featured-strip article, .comparison-grid article, .contact-panel, .featured-article { border: 1px solid var(--color-border); border-radius: var(--radius); background: #fff; padding: 1.1rem; box-shadow: 0 1px 0 rgba(15,23,42,.04); }\r\n.service-card img, .blog-card img, .portfolio-card img, .featured-strip img, .media-frame { width: 100%; border-radius: var(--radius); margin-bottom: 1rem; background: var(--color-bg-soft); }\r\n.service-card a, .blog-card a, .portfolio-card a { text-decoration: none; }\r\n.service-card:hover, .blog-card:hover, .portfolio-card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow); }\r\n.featured-article { display: grid; gap: 1.25rem; margin-bottom: 1.5rem; }\r\n@media (min-width: 760px) { .featured-article { grid-template-columns: 1fr 1.2fr; } }\r\n"},{"path":"src/scss/components/_accordion.scss","content":".accordion-item { border-bottom: 1px solid var(--color-border); }\r\n.accordion-item > button { width: 100%; border: 0; background: #fff; padding: 1.15rem 0; text-align: left; font-weight: 900; font-size: 1.05rem; cursor: pointer; }\r\n.accordion-item > button::after { content: \"+\"; float: right; color: var(--color-primary); }\r\n.accordion-item > button[aria-expanded=\"true\"]::after { content: \"-\"; }\r\n.accordion-item > div { padding-bottom: 1.2rem; }\r\n.accordion-item {\r\n  border-bottom: 1px solid var(--color-border);\r\n}\r\n\r\n.accordion-item > button {\r\n  width: 100%;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--color-text);\r\n  padding: 1.15rem 0;\r\n  text-align: left;\r\n  font-weight: 900;\r\n  cursor: pointer;\r\n}\r\n\r\n.accordion-item > button::after {\r\n  content: \"+\";\r\n  color: var(--color-primary);\r\n}\r\n\r\n.accordion-item > button[aria-expanded=\"true\"]::after {\r\n  content: \"-\";\r\n}\r\n\r\n.accordion-item > div {\r\n  padding-bottom: 1.15rem;\r\n}\r\n"},{"path":"src/scss/components/_badges.scss","content":".eyebrow { font-size: .75rem; text-transform: uppercase; }\r\n"}]

