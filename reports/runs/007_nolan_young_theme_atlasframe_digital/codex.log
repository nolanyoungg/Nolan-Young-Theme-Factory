+    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
+  }
+}
+
+@media (max-width: 520px) {
+  .container,
+  .container.narrow,
+  .narrow {
+    width: min(100% - 1rem, var(--container));
+  }
+
+  .section {
+    padding-block: 3rem;
+  }
+
+  .hero {
+    padding-block: 2rem 3rem;
+  }
+
+  .button-row,
+  .hero .button-row {
+    display: grid;
+    grid-template-columns: 1fr;
+  }
+
+  .button-row .btn {
+    width: 100%;
   }
 }
