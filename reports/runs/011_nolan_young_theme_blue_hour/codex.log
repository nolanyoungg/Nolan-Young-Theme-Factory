  .wordmark { font-size: 1.8rem; }
  .wordmark span { font-size: .5rem; }
  .menu-toggle:not([hidden]) { display: flex; }
  .site-navigation { display: grid; grid-template-columns: 1fr 1fr; flex-basis: 100%; padding-top: 1.5rem; gap: 0 1rem; min-width: 0; }
  .site-navigation > a { font-size: .95rem; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  .site-navigation.nav-enhanced { display: none; }
  .site-navigation.nav-enhanced.is-open { display: flex; flex-direction: column; align-items: stretch; }
  .mobile-note { display: block; font-size: .8rem; color: var(--muted); margin: 1.5rem 0 .25rem; grid-column: 1 / -1; }
}
