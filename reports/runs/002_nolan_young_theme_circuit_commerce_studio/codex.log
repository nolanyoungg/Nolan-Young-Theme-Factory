.site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); border-bottom: 1px solid transparent; transition: border-color var(--transition), box-shadow var(--transition); }
.site-header.is-scrolled { border-color: var(--color-border); box-shadow: 0 10px 28px rgba(15,23,42,.08); }
.site-header__inner { min-height: var(--header-height); width: min(100% - 2rem, var(--container)); margin-inline: auto; display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; }
.site-branding { display: inline-flex; align-items: center; gap: .75rem; text-decoration: none; min-width: max-content; }
.brand-mark { width: 42px; height: 42px; flex: 0 0 42px; }
.site-branding__text { display: grid; line-height: 1.1; }
.site-branding__name { font-weight: 900; font-size: 1.05rem; }
.site-branding__tagline { color: var(--color-muted); font-size: .78rem; }
.primary-navigation { display: none; justify-content: center; gap: .35rem; }
.nav-trigger, .nav-link { border: 0; background: transparent; color: var(--color-text); text-decoration: none; padding: .75rem .9rem; border-radius: var(--radius); font-weight: 800; cursor: pointer; }
.nav-trigger:hover, .nav-link:hover, .nav-trigger[aria-expanded="true"] { background: var(--color-bg-soft); }
.mobile-menu-toggle { justify-self: end; width: 46px; height: 46px; border: 1px solid var(--color-border); border-radius: var(--radius); background: #fff; display: grid; place-content: center; gap: 4px; }
.mobile-menu-toggle span:not(.screen-reader-text) { width: 20px; height: 2px; background: var(--color-text); display: block; }
.btn-header-cta { display: none; }
.menu-backdrop { position: fixed; inset: 0; z-index: 40; background: rgba(15, 23, 42, .44); }
.nolan-menu { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); z-index: 60; width: min(100% - 2rem, 1080px); background: #fff; border: 1px solid var(--color-border); border-radius: 0 0 var(--radius-lg) var(--radius-lg); box-shadow: var(--shadow); padding: 1rem; }
.nolan-menu__inner { display: grid; grid-template-columns: 240px 1fr; gap: 1.25rem; }
.nolan-menu__rail { display: grid; align-content: start; gap: .35rem; border-right: 1px solid var(--color-border); padding-right: 1rem; }
.nolan-menu__rail button { text-align: left; border: 0; border-radius: var(--radius); background: transparent; padding: .85rem; font-weight: 800; cursor: pointer; }
.nolan-menu__rail button.is-active, .nolan-menu__rail button:hover { background: var(--color-bg-soft); color: var(--color-primary); }
.nolan-menu__content section { grid-template-columns: 280px 1fr; gap: 1.25rem; align-items: center; }
.nolan-menu__content section.is-active { display: grid; }
.nolan-menu__content img, .nolan-menu__blog-grid img { border-radius: var(--radius); background: var(--color-bg-soft); }
.nolan-menu__blog-grid { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); }
.mobile-drawer { position: fixed; inset: 0 0 0 auto; width: min(92vw, 420px); z-index: 70; background: #fff; box-shadow: var(--shadow); padding: 1rem; overflow-y: auto; }
.mobile-drawer__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
.mobile-drawer__close { border: 1px solid var(--color-border); background: #fff; border-radius: var(--radius); padding: .55rem .8rem; }
.mobile-drawer nav, .mobile-accordion div { display: grid; gap: .5rem; }
.mobile-drawer nav > a, .mobile-accordion > button, .mobile-accordion div a { text-decoration: none; border: 0; border-radius: var(--radius); background: var(--color-bg-soft); padding: .9rem 1rem; color: var(--color-text); text-align: left; font-weight: 800; }
@media (min-width: 960px) { .primary-navigation { display: flex; } .mobile-menu-toggle { display: none; } .btn-header-cta { display: inline-flex; } }

