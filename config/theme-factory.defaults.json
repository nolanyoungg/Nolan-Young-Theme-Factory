{
  "default_mode": "hybrid",
  "default_template": "NOLAN-YOUNG-theme-000",
  "ollama": {
    "model": "qwen2.5-coder:14b"
  },
  "codex": {
    "model": "gpt-5.4",
    "reasoning": "medium"
  },
  "paths": {
    "templates": "wordpress-themplate-themes",
    "themes": "wp-content/themes",
    "zips": "dist/zipped-themes",
    "previews": "docs/Preview-Themes-Github",
    "run_reports": "reports/runs"
  },
  "validation": {
    "max_repair_attempts": 1,
    "require_template_manifest": true,
    "require_preview": true,
    "require_zip": true,
    "model_check_timeout_ms": 120000,
    "ollama_timeout_ms": 180000,
    "codex_timeout_ms": 180000,
    "command_timeout_ms": 120000
  },
  "retry": {
    "repair_attempts": 1,
    "command_retries": 0
  }
}
