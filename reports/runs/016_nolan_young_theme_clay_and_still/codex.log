+.skip-link { position: fixed; top: 12px; left: 12px; z-index: 100; padding: 12px 22px; background: var(--cocoa); color: var(--ivory); transform: translateY(-160%); }
+.skip-link:focus { transform: translateY(0); }
+.screen-reader-text { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+:focus-visible { outline: 2px solid var(--olive); outline-offset: 5px; }
+.site-footer :focus-visible { outline-color: var(--peach); }
+.reveal.is-seen { animation: settle-in .65s ease both; }
+@keyframes settle-in { from { opacity: .72; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
+@media (prefers-reduced-motion: reduce) {
+	html { scroll-behavior: auto; }
