# Keep text files stable across Windows and non-Windows checkouts.
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.php text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.scss text eol=lf
*.pot text eol=lf
*.keep text eol=lf

# Explicitly normalize the tracked preview fixture copy so it does not drift on Windows.
docs/Preview-Themes-Github/.preview-template/** text eol=lf

# WordPress theme template sources should also stay normalized.
wordpress-themplate-themes/** text eol=lf
wp-content/themes/** text eol=lf
