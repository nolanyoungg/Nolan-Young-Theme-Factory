omparison-grid article:first-child { background: var(--color-bg-soft); }\r\n.comparison-grid article:last-child { border-color: rgba(20,184,166,.45); box-shadow: inset 4px 0 0 var(--color-secondary); }\r\n@media (min-width: 760px) { .comparison-grid { grid-template-columns: 1fr 1fr; } }\r\n.before-after {\r\n  background: linear-gradient(180deg, #fff 0%, var(--color-bg-soft) 100%);\r\n}\r\n\r\n.comparison-grid h3 {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: .5rem;\r\n}\r\n\r\n.comparison-grid ul {\r\n  margin-bottom: 0;\r\n}\r\n"},{"path":"src/scss/components/_portfolio-filter.scss","content":".filter-controls { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.5rem 0 2rem; }\r\n.filter-controls button { border: 1px solid var(--color-border-strong); background: #fff; border-radius: 999px; padding: .65rem .95rem; font-weight: 800; cursor: pointer; }\r\n.filter-controls button.is-active, .filter-controls button:hover { background: var(--color-secondary); border-color: var(--color-secondary); color: #042f2e; }\r\n.portfolio-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }\r\n.filter-controls {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: .6rem;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.filter-controls button {\r\n  border: 1px solid var(--color-border-strong);\r\n  border-radius: 999px;\r\n  background: #fff;\r\n  color: var(--color-text);\r\n  padding: .62rem .9rem;\r\n  font-weight: 900;\r\n  cursor: pointer;\r\n}\r\n\r\n.filter-controls button:hover,\r\n.filter-controls button.is-active {\r\n  border-color: var(--color-secondary);\r\n  background: rgba(20, 184, 166, .12);\r\n  color: #0f766e;\r\n}\r\n\r\n.portfolio-card[hidden] {\r\n  display: none !important;\r\n}\r\n"}]

