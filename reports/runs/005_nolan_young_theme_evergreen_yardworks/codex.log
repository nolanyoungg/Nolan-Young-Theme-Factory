-.info-card img,
 .service-card img,
 .portfolio-card img,
 .blog-card img,
-.work-card img,
-.article-card img {
+.featured-strip img,
+.featured-article img {
   width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: var(--radius);
   margin-bottom: 1rem;
+  background: var(--color-bg-soft);
+}
+
+.service-card a,
+.blog-card a,
+.portfolio-card a,
+.featured-strip a {
+  text-decoration: none;
+}
+
+.service-card:hover,
+.blog-card:hover,
+.portfolio-card:hover {
+  border-color: var(--color-border-strong);
+  box-shadow: var(--shadow);
+}
+
+.service-selector__layout {
+  display: grid;
+  gap: 1rem;
+}
+
+.service-selector__tabs,
+.season-tabs__controls {
+  display: flex;
+  flex-wrap: wrap;
+  gap: .55rem;
+}
+
+.service-selector__tabs button,
+.season-tabs__controls button,
+.filter-controls button {
+  border: 1px solid var(--color-border-strong);
+  border-radius: 999px;
+  background: #fff;
+  color: var(--color-text);
+  padding: .62rem .9rem;
+  font-weight: 900;
+  cursor: pointer;
+}
+
+.service-selector__tabs button.is-active,
+.season-tabs__controls button.is-active,
+.filter-controls button.is-active,
+.service-selector__tabs button:hover,
+.season-tabs__controls button:hover,
+.filter-controls button:hover {
+  border-color: var(--color-primary);
+  background: var(--color-bg-green);
+  color: var(--color-primary-hover);
+}
+
+.service-selector__panel {
+  display: grid;
+  gap: 1.25rem;
+  align-items: center;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-lg);
+  background: var(--color-bg-soft);
+  padding: clamp(1rem, 3vw, 2rem);
+}
+
+.service-selector__panel img {
+  width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
   border-radius: var(--radius);
 }
 
-.featured-work-strip {
+.seasonal-band {
   background: var(--color-dark);
   color: #fff;
 }
 
-.featured-work-strip a {
-  color: #fff;
+.seasonal-band p {
+  color: rgba(255, 255, 255, .78);
 }
 
-.process-list {
+.seasonal-band__inner {
   display: grid;
-  gap: 1rem;
-  counter-reset: process;
+  gap: 1.5rem;
 }
 
-.process-list > * {
-  position: relative;
-  border-left: 3px solid var(--color-secondary);
-  background: var(--color-bg-soft);
-  padding: 1rem 1rem 1rem 1.25rem;
+.season-tabs__panel {
+  margin-top: 1rem;
+  max-width: 62ch;
 }
 
-.case-study__list {
+.process-list {
+  list-style: none;
+  counter-reset: step;
   display: grid;
-  gap: .75rem;
+  gap: 1rem;
+  padding: 0;
+  margin: 0;
 }
 
-.case-study__list dt {
+.process-list li {
+  counter-increment: step;
+  border: 1px solid rgba(255, 255, 255, .16);
+  border-radius: var(--radius);
+  background: rgba(255, 255, 255, .07);
+  padding: 1rem;
+}
+
+.process-list li::before {
+  content: counter(step, decimal-leading-zero);
+  display: block;
+  color: var(--color-accent);
   font-weight: 900;
+}
+
+.process-list span {
   color: #fff;
+  font-weight: 900;
+}
+
+.route-band {
+  background:
+    linear-gradient(rgba(245, 241, 232, .92), rgba(245, 241, 232, .92)),
+    url("../../assets/images/texture/meadow-texture.jpg") center / cover;
 }
 
-.comparison-grid {
+.route-band__grid {
   display: grid;
-  gap: 1rem;
+  gap: 1.5rem;
+  align-items: center;
+}
+
+.route-map {
+  position: relative;
+  min-height: 220px;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-lg);
+  background: rgba(255, 255, 255, .74);
+  overflow: hidden;
+}
+
+.route-map::before {
+  content: "";
+  position: absolute;
+  inset: 22% 12%;
+  border: 4px dashed var(--color-secondary);
+  border-radius: 50%;
+  transform: rotate(-8deg);
 }
 
-.comparison-grid article:first-child {
-  border-top: 4px solid var(--color-accent);
+.route-map span {
+  position: absolute;
+  width: 16px;
+  height: 16px;
+  border-radius: 50%;
+  background: var(--color-primary);
+  box-shadow: 0 0 0 6px rgba(47, 107, 63, .14);
 }
 
-.comparison-grid article:last-child {
-  border-top: 4px solid var(--color-secondary);
+.route-map span:nth-child(1) { top: 25%; left: 18%; }
+.route-map span:nth-child(2) { top: 56%; left: 34%; }
+.route-map span:nth-child(3) { top: 32%; left: 62%; }
+.route-map span:nth-child(4) { top: 68%; left: 78%; }
+
+.proof-grid {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
 }
 
-.comparison-grid article {
+.proof-grid > div {
+  border-left: 4px solid var(--color-secondary);
   border-radius: var(--radius);
-  border: 1px solid var(--color-border);
-  padding: 1.25rem;
-  background: #fff;
+  background: var(--color-bg-green);
+  padding: 1rem;
 }
 
+.page-hero,
 .faq-section {
   background: var(--color-bg-soft);
 }
 
-.final-cta .container {
-  max-width: 820px;
+.featured-article {
+  display: grid;
+  gap: 1.25rem;
+  margin-bottom: 1.5rem;
 }
 
+[data-reveal] {
+  transform: translateY(14px);
+  opacity: 0;
+  transition: transform 420ms ease, opacity 420ms ease;
+}
+
+[data-reveal].is-visible {
+  transform: translateY(0);
+  opacity: 1;
+}
+
 @media (min-width: 760px) {
   .split,
   .hero__grid,
-  .brand-statement,
-  .single-service-highlight,
-  .business-solution {
-    grid-template-columns: minmax(0, 1fr) minmax(300px, .9fr);
+  .service-selector__panel,
+  .route-band__grid,
+  .seasonal-band__inner {
+    grid-template-columns: minmax(0, 1fr) minmax(300px, .95fr);
+  }
+
+  .portfolio-grid,
+  .featured-strip__grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+
+  .process-list {
+    grid-template-columns: repeat(5, minmax(0, 1fr));
+  }
+
+  .featured-article {
+    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
+  }
+}
+
+@media (max-width: 760px) {
+  .container,
+  .template-container,
+  .container.narrow,
+  .narrow {
+    width: min(100% - 1rem, var(--container));
+  }
+
+  .section,
+  .template-section {
+    padding-block: 3rem;
+  }
+
+  .hero {
+    min-height: auto;
+    padding-block: 1.5rem 2rem;
+  }
+
+  .hero__grid {
+    grid-template-columns: 1fr;
+    gap: 1rem;
+  }
+
+  .hero__copy {
+    min-width: 0;
+    max-width: 100%;
+  }
+
+  .hero__copy > p:not(.eyebrow) {
+    max-width: 100%;
+    overflow-wrap: break-word;
+  }
+
+  .hero__visual img {
+    max-height: 34svh;
+    aspect-ratio: 16 / 10;
+  }
+
+  .button-row {
+    display: grid;
+    grid-template-columns: 1fr;
+  }
+
+  .button-row .btn {
+    width: 100%;
+    max-width: 100%;
+    white-space: normal;
+  }
+
+  .trust-row {
+    display: grid;
+    grid-template-columns: 1fr;
   }
 
-  .comparison-grid {
-    grid-template-columns: repeat(2, 1fr);
+  .quick-trust__grid {
+    grid-template-columns: 1fr 1fr;
   }
 
-  .portfolio-grid,
-  .blog-grid {
-    grid-template-columns: repeat(3, 1fr);
+  .section-heading--row {
+    display: grid;
   }
 }
+
+@media (max-width: 430px) {
+  .quick-trust__grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-reveal] {
+    transform: none;
+    opacity: 1;
+    transition: none;
+  }
+}
+
