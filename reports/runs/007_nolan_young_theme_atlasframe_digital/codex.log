diff --git a/wp-content/themes/007_nolan_young_theme_atlasframe_digital/README.md b/wp-content/themes/007_nolan_young_theme_atlasframe_digital/README.md
index f66f3418336e47b1b4cf46a2947a2c152d4dda05..873336b993a62f62abdf26193b177b33cdb9f28c
--- a/wp-content/themes/007_nolan_young_theme_atlasframe_digital/README.md
