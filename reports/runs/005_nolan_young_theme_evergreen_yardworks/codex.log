+    gap: 1rem;
+  }
+
+  .hero__copy {
+    min-width: 0;
+    max-width: 100%;
+  }
+
+  .hero__copy > p:not(.eyebrow) {
+    max-width: 100%;
+    overflow-wrap: break-word;
+  }
+
+  .hero__visual img {
+    max-height: 34svh;
+    aspect-ratio: 16 / 10;
+  }
+
+  .button-row {
+    display: grid;
+    grid-template-columns: 1fr;
+  }
+
+  .button-row .btn {
+    width: 100%;
+    max-width: 100%;
+    white-space: normal;
+  }
+
+  .trust-row {
