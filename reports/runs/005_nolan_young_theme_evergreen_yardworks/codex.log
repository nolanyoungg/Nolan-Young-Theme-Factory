 }
 
-.featured-work-strip a {
-  color: #fff;
+.seasonal-band p {
+  color: rgba(255, 255, 255, .78);
 }
 
-.process-list {
+.seasonal-band__inner {
   display: grid;
-  gap: 1rem;
-  counter-reset: process;
