+  top: 0;
+  z-index: 50;
+  background: rgba(255, 255, 255, .96);
+  border-bottom: 1px solid var(--color-border);
+  transition: box-shadow var(--transition);
+}
+
+.site-header.is-scrolled {
+  box-shadow: 0 10px 28px rgba(20, 37, 27, .1);
+}
+
+.site-status {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: .35rem .9rem;
+  padding: .42rem 1rem;
+  background: var(--color-dark);
+  color: #fff;
+  font-size: .82rem;
+  font-weight: 800;
+  text-align: center;
+}
+
+.site-status span {
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.site-header__inner {
+  min-height: var(--header-height);
+  width: min(100% - 2rem, var(--container));
+  margin-inline: auto;
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  gap: 1rem;
+  align-items: center;
+}
+
+.site-branding {
+  display: inline-flex;
+  align-items: center;
+  gap: .7rem;
+  min-width: 0;
+  color: var(--color-text);
+  text-decoration: none;
+}
+
+.brand-mark {
+  width: 42px;
+  height: 42px;
+  flex: 0 0 42px;
+}
+
+.site-branding__text {
+  display: grid;
+  min-width: 0;
+  line-height: 1.08;
+}
+
+.site-branding__name {
+  font-size: 1.03rem;
+  font-weight: 900;
+  overflow-wrap: anywhere;
+}
+
+.site-branding__tagline {
+  color: var(--color-muted);
+  font-size: .76rem;
+}
+
+.primary-navigation {
+  display: none;
+  justify-content: center;
+  gap: .2rem;
+}
+
+.nav-trigger,
+.nav-link {
+  border: 0;
+  border-radius: var(--radius);
+  background: transparent;
+  color: var(--color-text);
+  text-decoration: none;
+  padding: .68rem .72rem;
+  font-weight: 850;
+  cursor: pointer;
+}
+
+.nav-trigger:hover,
+.nav-link:hover,
+.nav-trigger[aria-expanded="true"] {
+  background: var(--color-bg-green);
+  color: var(--color-primary-hover);
+}
+
+.btn-header-cta {
+  display: none;
+  white-space: nowrap;
+}
+
+.mobile-menu-toggle {
+  justify-self: end;
+  width: 44px;
+  height: 44px;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+  background: #fff;
+  display: grid;
+  place-content: center;
+  gap: 4px;
+}
+
+.mobile-menu-toggle span:not(.screen-reader-text) {
+  display: block;
+  width: 20px;
+  height: 2px;
+  background: var(--color-text);
+}
+
+.menu-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  background: rgba(20, 37, 27, .42);
+}
+
+.nolan-menu {
+  position: absolute;
+  top: 100%;
+  left: 50%;
+  z-index: 60;
+  width: min(100% - 2rem, 1080px);
+  transform: translateX(-50%);
+  border: 1px solid var(--color-border);
+  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
+  background: #fff;
+  box-shadow: var(--shadow);
+  padding: 1rem;
+}
+
+.nolan-menu__inner {
+  display: grid;
+  grid-template-columns: 250px minmax(0, 1fr);
+  gap: 1.25rem;
+}
+
+.nolan-menu__rail {
+  display: grid;
+  align-content: start;
+  gap: .3rem;
+  border-right: 1px solid var(--color-border);
+  padding-right: 1rem;
+}
+
+.nolan-menu__rail button {
+  border: 0;
+  border-radius: var(--radius);
+  background: transparent;
+  color: var(--color-text);
+  padding: .78rem;
+  text-align: left;
+  font-weight: 850;
+  cursor: pointer;
+}
+
+.nolan-menu__rail button.is-active,
+.nolan-menu__rail button:hover {
+  background: var(--color-bg-green);
+  color: var(--color-primary-hover);
+}
+
+.nolan-menu__content section {
+  grid-template-columns: 300px minmax(0, 1fr);
+  gap: 1.25rem;
+  align-items: center;
+}
+
+.nolan-menu__content section.is-active {
+  display: grid;
+}
+
+.nolan-menu__content img,
+.nolan-menu__blog-grid img {
+  width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: var(--radius);
+  background: var(--color-bg-soft);
+}
+
+.nolan-menu__blog-grid {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+}
+
+.mobile-drawer {
+  position: fixed;
+  inset: 0 0 0 auto;
+  z-index: 70;
+  width: min(92vw, 420px);
+  max-width: 100%;
+  overflow-y: auto;
+  background: #fff;
+  box-shadow: var(--shadow);
+  padding: 1rem;
+}
+
+.mobile-drawer__top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  margin-bottom: 1.25rem;
+}
+
+.mobile-drawer__close {
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+  background: #fff;
+  padding: .55rem .8rem;
+}
+
+.mobile-drawer nav,
+.mobile-accordion div {
+  display: grid;
+  gap: .5rem;
+}
+
+.mobile-drawer nav > a,
+.mobile-accordion > button,
+.mobile-accordion div a {
+  min-width: 0;
+  border: 0;
+  border-radius: var(--radius);
+  background: var(--color-bg-green);
+  color: var(--color-text);
+  padding: .86rem .95rem;
+  text-align: left;
+  text-decoration: none;
+  font-weight: 850;
+  overflow-wrap: anywhere;
+}
+
+@media (min-width: 1060px) {
+  .primary-navigation {
+    display: flex;
+  }
+
+  .mobile-menu-toggle {
+    display: none;
+  }
+
+  .btn-header-cta {
+    display: inline-flex;
+  }
+}
+
+@media (max-width: 760px) {
+  .site-status {
+    justify-content: flex-start;
+    font-size: .76rem;
+    line-height: 1.25;
+  }
+
+  .site-header__inner {
+    width: min(100% - 1rem, var(--container));
+    grid-template-columns: minmax(0, 1fr) auto;
+  }
+
+  .site-branding__tagline {
+    display: none;
+  }
+}
+
