+	wp_enqueue_script( 'clay-still', get_theme_file_uri( $js ), array(), (string) filemtime( get_theme_file_path( $js ) ), true );
+}
+add_action( 'wp_enqueue_scripts', 'clay_still_enqueue' );
 
