+  display: grid;
+  min-width: 0;
+  line-height: 1.1;
+}
+
+.site-branding__name {
+  font-size: 1.02rem;
+  font-weight: 900;
+  overflow-wrap: anywhere;
+}
+
+.site-branding__tagline {
+  color: var(--color-muted);
+  font-size: .76rem;
+}
+
+.primary-navigation {
+  display: none;
+  justify-content: center;
+  gap: .25rem;
+}
+
+.nav-trigger,
+.nav-link {
+  border: 0;
+  border-radius: var(--radius);
+  background: transparent;
+  color: var(--color-text);
+  cursor: pointer;
+  font-weight: 800;
+  padding: .75rem .9rem;
+  text-decoration: none;
+}
+
+.nav-trigger:hover,
+.nav-link:hover,
+.nav-trigger[aria-expanded="true"] {
+  background: var(--color-bg-soft);
+}
+
+.mobile-menu-toggle {
+  justify-self: end;
+  width: 46px;
+  height: 46px;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+  background: #fff;
+  display: grid;
+  place-content: center;
+  gap: 4px;
+}
+
+.mobile-menu-toggle span:not(.screen-reader-text) {
+  width: 20px;
+  height: 2px;
+  display: block;
+  background: var(--color-text);
+}
+
+.btn-header-cta {
+  display: none;
+}
+
+.menu-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  background: rgba(11, 17, 32, .48);
+}
+
+.nolan-menu {
+  position: absolute;
+  top: 100%;
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 60;
+  width: min(100% - 2rem, 1080px);
+  max-height: calc(100vh - var(--header-height) - 1rem);
+  overflow: auto;
+  background: var(--color-bg);
+  border: 1px solid var(--color-border);
+  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
+  box-shadow: var(--shadow);
+  padding: 1rem;
+}
+
+.nolan-menu__inner {
+  display: grid;
+  grid-template-columns: 245px minmax(0, 1fr);
+  gap: 1.25rem;
+}
+
+.nolan-menu__rail {
+  display: grid;
+  align-content: start;
+  gap: .35rem;
+  border-right: 1px solid var(--color-border);
+  padding-right: 1rem;
+}
+
+.nolan-menu__rail button {
+  text-align: left;
+  border: 0;
+  border-radius: var(--radius);
+  background: transparent;
+  color: var(--color-text);
+  padding: .85rem;
+  font-weight: 800;
+  cursor: pointer;
+}
+
+.nolan-menu__rail button.is-active,
+.nolan-menu__rail button:hover {
+  background: var(--color-bg-soft);
+  color: var(--color-primary);
+}
+
+.nolan-menu__content section {
+  grid-template-columns: minmax(220px, 290px) minmax(0, 1fr);
+  gap: 1.25rem;
+  align-items: center;
+}
+
+.nolan-menu__content section.is-active {
+  display: grid;
+}
+
+.nolan-menu__content img,
+.nolan-menu__blog-grid img {
+  width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: var(--radius);
+  background: var(--color-bg-soft);
+}
+
+.nolan-menu__blog-grid {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.mobile-drawer {
+  position: fixed;
+  inset: 0 0 0 auto;
+  width: min(92vw, 420px);
+  max-width: 100%;
+  z-index: 70;
+  background: var(--color-bg);
+  box-shadow: var(--shadow);
+  padding: 1rem;
+  overflow-y: auto;
+}
+
+.mobile-drawer__top {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 1rem;
+  margin-bottom: 1.25rem;
+}
+
+.mobile-drawer__close {
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+  background: #fff;
+  padding: .55rem .8rem;
+}
+
+.mobile-drawer nav,
+.mobile-accordion div {
+  display: grid;
+  gap: .5rem;
+}
+
+.mobile-drawer nav > a,
+.mobile-accordion > button,
+.mobile-accordion div a {
+  width: 100%;
+  min-width: 0;
+  border: 0;
+  border-radius: var(--radius);
+  background: var(--color-bg-soft);
+  color: var(--color-text);
+  font-weight: 800;
+  padding: .9rem 1rem;
+  text-align: left;
+  text-decoration: none;
+  overflow-wrap: anywhere;
+}
+
+@media (min-width: 960px) {
+  .primary-navigation {
+    display: flex;
+  }
+
+  .mobile-menu-toggle {
+    display: none;
+  }
+
+  .btn-header-cta {
+    display: inline-flex;
+  }
+}
+
+@media (max-width: 520px) {
+  .site-header__inner {
+    width: min(100% - 1rem, var(--container));
+    gap: .65rem;
+  }
+
+  .brand-mark {
+    width: 38px;
+    height: 38px;
+    flex-basis: 38px;
+  }
+
+  .site-branding__tagline {
+    display: none;
+  }
+}
