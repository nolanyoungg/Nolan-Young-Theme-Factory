{
  "name": "nolan-young-theme-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Node-only automation for generating, validating, previewing, and packaging Nolan Young WordPress themes.",
  "scripts": {
    "theme:run": "node scripts/run-theme-workflow.js",
    "theme:resume": "node scripts/run-theme-workflow.js --resume",
    "theme:prepare": "node scripts/prepare-theme.js",
    "theme:validate": "node scripts/validate-theme.js",
    "theme:build": "node scripts/build-theme.js",
    "theme:preview": "node scripts/preview-theme.js",
    "theme:preview:index": "node scripts/preview-theme.js --rebuild-index",
    "theme:zip": "node scripts/package-theme.js",
    "theme:delete": "node scripts/delete-theme.js",
    "theme:env": "node scripts/check-environment.js",
    "theme:model-check": "node scripts/check-model.js",
    "test:scripts": "node scripts/tests/smoke.js"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "yauzl": "3.4.0"
  }
}
