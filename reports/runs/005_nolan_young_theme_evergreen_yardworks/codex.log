+  border: 1px solid var(--color-border);
+  border-radius: 999px;
+  background: #fff;
+  padding: .45rem .72rem;
+  color: var(--color-text);
+  font-weight: 850;
+  overflow-wrap: anywhere;
+}
+
+.quick-trust {
+  border-block: 1px solid var(--color-border);
+  background: var(--color-bg-soft);
+  padding-block: .9rem;
+}
+
+.quick-trust__grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: .75rem;
+}
+
+.quick-trust__grid div {
+  display: flex;
+  align-items: center;
+  gap: .5rem;
+  min-width: 0;
+  font-weight: 850;
+  overflow-wrap: anywhere;
+}
+
+.quick-trust__grid span {
+  width: .7rem;
+  height: .7rem;
+  flex: 0 0 .7rem;
+  border-radius: 999px;
+  background: var(--color-accent);
+}
+
 .card-grid,
 .portfolio-grid,
-.blog-grid,
-.footer-widgets {
+.featured-strip__grid,
+.proof-grid {
   display: grid;
   gap: 1rem;
 }
 
-.card-grid--three,
-.service-grid {
-  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+.card-grid {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 255px), 1fr));
 }
 
+.card-grid--three {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+}
+
+.card-grid--plans {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
+}
+
 .info-card,
 .service-card,
 .portfolio-card,
 .blog-card,
-.work-card,
-.article-card,
+.featured-strip article,
+.contact-panel,
+.featured-article,
 .package-card {
   border: 1px solid var(--color-border);
   border-radius: var(--radius);
   background: #fff;
-  padding: clamp(1rem, 2vw, 1.4rem);
-  box-shadow: 0 8px 26px rgba(15, 23, 42, .06);
+  padding: clamp(1rem, 2vw, 1.35rem);
+  box-shadow: 0 8px 26px rgba(20, 37, 27, .06);
 }
 
-.info-card img,
 .service-card img,
 .portfolio-card img,
 .blog-card img,
-.work-card img,
-.article-card img {
+.featured-strip img,
+.featured-article img {
   width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: var(--radius);
   margin-bottom: 1rem;
+  background: var(--color-bg-soft);
+}
+
+.service-card a,
+.blog-card a,
+.portfolio-card a,
+.featured-strip a {
+  text-decoration: none;
+}
+
+.service-card:hover,
+.blog-card:hover,
+.portfolio-card:hover {
+  border-color: var(--color-border-strong);
+  box-shadow: var(--shadow);
+}
+
+.service-selector__layout {
+  display: grid;
+  gap: 1rem;
+}
+
+.service-selector__tabs,
+.season-tabs__controls {
+  display: flex;
