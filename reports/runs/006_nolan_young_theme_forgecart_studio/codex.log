+  border-radius: var(--radius-lg);
+  border: 1px solid var(--color-border);
+  background: var(--color-bg-soft);
+  box-shadow: var(--shadow);
+}
+
+.trust-row,
+.stats-row {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
+  gap: .75rem;
+  margin: 1.25rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.trust-row > *,
+.stats-row > * {
+  min-width: 0;
+  border: 1px solid var(--color-border);
+  border-radius: 999px;
+  background: #fff;
+  padding: .6rem .8rem;
+  font-weight: 850;
+  text-align: center;
+}
+
+.card-grid,
+.portfolio-grid,
+.blog-grid,
+.featured-strip__grid,
+.proof-grid {
+  display: grid;
+  gap: 1rem;
+}
+
+.card-grid,
+.card-grid--three,
+.service-grid {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
+}
+
+.info-card,
+.service-card,
+.portfolio-card,
+.blog-card,
+.work-card,
+.article-card,
+.package-card,
+.featured-strip article,
+.contact-panel,
+.featured-article {
+  min-width: 0;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+  background: #fff;
+  padding: clamp(1rem, 2vw, 1.4rem);
+  box-shadow: 0 8px 26px rgba(15, 23, 42, .06);
+}
+
+.info-card img,
+.service-card img,
+.portfolio-card img,
+.blog-card img,
+.work-card img,
+.article-card img,
+.featured-strip img {
+  width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  margin-bottom: 1rem;
+  border-radius: var(--radius);
+}
+
+.featured-strip {
+  background: #fff;
+}
+
+.process-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
+  gap: 1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  counter-reset: step;
+}
+
+.process-list li {
+  counter-increment: step;
+  border: 1px solid rgba(226, 232, 240, .18);
+  border-radius: var(--radius);
+  background: rgba(255, 255, 255, .06);
+  padding: 1rem;
+}
+
+.process-list li::before {
+  content: counter(step, decimal-leading-zero);
+  display: block;
+  color: var(--color-accent);
+  font-weight: 900;
+}
+
+.process-list span {
+  color: #fff;
+  font-weight: 900;
+}
+
+.case-study__list,
+.comparison-grid {
+  display: grid;
+  gap: 1rem;
+}
+
+.case-study__list dt {
+  color: #fff;
+  font-weight: 900;
+}
+
+.comparison-grid article {
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+  background: #fff;
+  padding: 1.25rem;
+}
+
+.comparison-grid article:first-child {
+  border-top: 4px solid var(--color-accent);
+}
+
+.comparison-grid article:last-child {
+  border-top: 4px solid var(--color-secondary);
+}
+
+.proof-grid {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
+}
+
+.proof-grid > div {
+  border-left: 4px solid var(--color-secondary);
+  border-radius: var(--radius);
+  background: var(--color-bg-soft);
+  padding: 1rem;
+}
+
+.page-hero,
+.faq-section {
+  background: var(--color-bg-soft);
+}
+
+.final-cta .container {
+  max-width: 820px;
+}
+
+@media (min-width: 760px) {
+  .split,
+  .hero__grid,
+  .brand-statement,
+  .single-service-highlight,
+  .business-solution,
+  .featured-article {
+    grid-template-columns: minmax(0, 1fr) minmax(300px, .92fr);
+  }
+
+  .comparison-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .portfolio-grid,
+  .blog-grid,
+  .featured-strip__grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 520px) {
+  .container,
+  .container.narrow,
+  .narrow {
+    width: min(100% - 1rem, var(--container));
+  }
+
+  .hero {
+    min-height: auto;
+    padding-block: 2rem 2.5rem;
+  }
+
+  .hero__grid {
+    gap: 1.25rem;
+  }
+
+  .hero__copy p {
+    max-width: 100%;
+  }
+
+  .button-row {
+    display: grid;
+    grid-template-columns: 1fr;
+    width: 100%;
+  }
+
+  .button-row .btn {
+    width: 100%;
+  }
+
+  .trust-row {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .hero__visual img {
+    aspect-ratio: 16 / 11;
+  }
+}
