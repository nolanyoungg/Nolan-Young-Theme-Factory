+@media (min-width: 960px) {
+  .site-header__inner {
+    grid-template-columns: auto minmax(0, 1fr) auto;
+  }
+
+  .primary-navigation {
+    display: flex;
+    justify-content: center;
+    gap: .35rem;
+  }
+
+  .mobile-menu-toggle {
+    display: none;
+  }
+
+  .btn-header-cta {
+    display: inline-flex;
+  }
+}
