+    width: min(100% - 1rem, var(--container));
+  }
+
+  .brand-mark {
+    width: 36px;
+    height: 36px;
+    flex-basis: 36px;
+  }
+
+  .site-branding__tagline {
+    display: none;
+  }
+}
