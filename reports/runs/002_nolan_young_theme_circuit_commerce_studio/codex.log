--- src/scss/layout/_footer.scss ---
.site-footer { background: var(--color-dark); color: #fff; }
.site-footer p, .site-footer a { color: #dbeafe; }
.footer-cta { background: var(--color-bg-soft); color: var(--color-text); padding: 3rem 0; }
.footer-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
.footer-cta h2 { max-width: 760px; }
.site-footer__inner { width: min(100% - 2rem, var(--container)); margin-inline: auto; padding: 4rem 0 1.5rem; }
.footer-widgets { display: grid; gap: 2rem; }
.footer-widgets nav, .footer-contact { display: grid; align-content: start; gap: .6rem; }
.footer-widgets h2 { font-size: 1rem; color: #fff; }
.footer-widgets a { text-decoration: none; }
.footer-widgets a:hover { color: #fff; text-decoration: underline; }
.footer-brand { max-width: 360px; }
.site-footer__legal { border-top: 1px solid rgba(226,232,240,.22); margin-top: 3rem; padding-top: 1.25rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
.site-footer__legal nav { display: flex; gap: 1rem; }
@media (min-width: 760px) { .footer-widgets { grid-template-columns: 2fr 1fr 1fr 1.3fr 1.4fr; } }
.site-footer {
  background: var(--color-dark);
  color: #fff;
}

.site-footer__inner {
  width: min(100% - 2rem, var(--container));
  margin-inline: auto;
  padding-block: 3rem 1.25rem;
}

.footer-cta {
  background: var(--color-primary);
  color: #fff;
  padding: clamp(2rem, 5vw, 4rem) 1rem;
}

.footer-widgets {
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  align-items: start;
}

.footer-brand {
  grid-column: span 2;
  max-width: 420px;
}

.site-footer h2,
.site-footer h3,
.site-footer p {
  color: #fff;
}

.site-footer p,
.site-footer li {
  color: rgba(255, 255, 255, .72);
}

.site-footer nav {
  display: grid;
  gap: .5rem;
}

.site-footer a {
  color: rgba(255, 255, 255, .86);
  text-decoration: none;
}

.site-footer a:hover {
  color: #fff;
  text-decoration: underline;
}

.site-footer__legal {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 2rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(255, 255, 255, .16);
}
--- src/scss/layout/_sections.scss ---
.hero { padding: clamp(4rem, 9vw, 8rem) 0; background: linear-gradient(180deg, #fff, var(--color-bg-soft)); }
.hero__grid { display: grid; gap: 2rem; align-items: center; }
.hero__visual img { border-radius: var(--radius-lg); box-shadow: var(--shadow); }
.trust-row { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }
.trust-row li { border: 1px solid var(--color-border); background: #fff; border-radius: 999px; padding: .45rem .75rem; font-weight: 800; }
.section-heading { max-width: 850px; margin-bottom: 2rem; }
.section-heading--row { max-width: none; display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.featured-strip { background: #fff; }
.featured-strip__grid, .proof-grid, .process-list { display: grid; gap: 1rem; }
.process-list { list-style: none; counter-reset: step; padding: 0; margin: 0; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
.process-list li { counter-increment: step; border: 1px solid rgba(226,232,240,.18); border-radius: var(--radius); padding: 1rem; background: rgba(255,255,255,.06); }
.process-list li::before { content: counter(step, decimal-leading-zero); display: block; color: var(--color-secondary); font-weight: 900; }
.process-list span { color: #fff; font-weight: 900; }
.case-study__list { display: grid; gap: .5rem; }
.case-study__list dt { font-weight: 900; color: #fff; }
.proof-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.proof-grid > div { padding: 1rem; border-left: 4px solid var(--color-secondary); background: var(--color-bg-soft); border-radius: var(--radius); }
.page-hero { background: var(--color-bg-soft); }
@media (min-width: 900px) { .hero__grid { grid-template-columns: 1fr 1fr; } .featured-strip__grid { grid-template-columns: repeat(3, 1fr); } }
.site-main {
  overflow-x: clip;
}

.container {
  width: min(100% - 2rem, var(--container));
  margin-inline: auto;
}

.container.narrow,
.narrow {
  width: min(100% - 2rem, var(--container-narrow));
  margin-inline: auto;
}

.section {
  padding-block: clamp(3.5rem, 7vw, 7rem);
}

.section-heading {
  max-width: 760px;
  margin-bottom: clamp(1.5rem, 4vw, 3rem);
}

.center {
  text-align: center;
}

.split {
  display: grid;
  gap: clamp(1.5rem, 4vw, 4rem);
  align-items: center;
}

.section-dark {
  background: var(--color-dark);
  color: #fff;
}

.section-dark p,
.section-dark dd,
.section-dark li {
  color: rgba(255, 255, 255, .78);
}

.eyebrow {
  margin: 0 0 .7rem;
  color: var(--color-secondary);
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.hero {
  padding-block: clamp(4rem, 8vw, 8rem);
  background: linear-gradient(180deg, #ffffff 0%, var(--color-bg-soft) 100%);
}

.hero__grid,
.brand-statement,
.single-service-highlight,
.business-solution {
  display: grid;
  gap: clamp(1.5rem, 4vw, 4rem);
  align-items: center;
}

.hero__summary,
.trust-row,
.stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: .8rem;
  margin-top: 1.5rem;
}

.hero__summary > *,
.trust-row > *,
.stats-row > * {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: #fff;
  padding: 1rem;
}

.media-frame,
.northstar-image {
  display: block;
  width: 100%;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  background: var(--color-bg-soft);
  box-shadow: var(--shadow);
}

.card-grid,
.portfolio-grid,
.blog-grid,
.footer-widgets {
  display: grid;
  gap: 1rem;
}

.card-grid--three,
.service-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.info-card,
.service-card,
.portfolio-card,
.blog-card,
.work-card,
.article-card,
.package-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: #fff;
  padding: clamp(1rem, 2vw, 1.4rem);
  box-shadow: 0 8px 26px rgba(15, 23, 42, .06);
}

.info-card img,
.service-card img,
.portfolio-card img,
.blog-card img,
.work-card img,
.article-card img {
  width: 100%;
  margin-bottom: 1rem;
  border-radius: var(--radius);
}

.featured-work-strip {
  background: var(--color-dark);
  color: #fff;
}

.featured-work-strip a {
  color: #fff;
}

.process-list {
  display: grid;
  gap: 1rem;
  counter-reset: process;
}

.process-list > * {
  position: relative;
  border-left: 3px solid var(--color-secondary);
  background: var(--color-bg-soft);
  padding: 1rem 1rem 1rem 1.25rem;
}

.case-study__list {
  display: grid;
  gap: .75rem;
}

.case-study__list dt {
  font-weight: 900;
  color: #fff;
}

.comparison-grid {
  display: grid;
  gap: 1rem;
}

.comparison-grid article:first-child {
  border-top: 4px solid var(--color-accent);
}

.comparison-grid article:last-child {
  border-top: 4px solid var(--color-secondary);
}

.comparison-grid article {
  border-radius: var(--radius);
  border: 1px solid var(--color-border);
  padding: 1.25rem;
  background: #fff;
}

.faq-section {
  background: var(--color-bg-soft);
}

.final-cta .container {
  max-width: 820px;
}

@media (min-width: 760px) {
  .split,
  .hero__grid,
  .brand-statement,
  .single-service-highlight,
  .business-solution {
    grid-template-columns: minmax(0, 1fr) minmax(300px, .9fr);
--- src/scss/base/_typography.scss ---
body { font-size: 16px; line-height: 1.65; }
h1, h2, h3, h4 { line-height: 1.08; margin: 0 0 1rem; letter-spacing: 0; }
h1 { font-size: clamp(2.5rem, 7vw, 5.8rem); max-width: 12ch; }
h2 { font-size: clamp(2rem, 4vw, 3.65rem); }
h3 { font-size: clamp(1.25rem, 2vw, 1.65rem); }
p { margin: 0 0 1rem; color: var(--color-muted); }
.eyebrow { color: var(--color-primary); font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
.section-dark .eyebrow, .site-footer .eyebrow { color: #93c5fd; }
.section-dark, .section-dark p, .section-dark a { color: #fff; }
body {
  font-size: 1rem;
  line-height: 1.65;
}

h1,
h2,
h3,
h4 {
  margin: 0 0 .75rem;
  color: inherit;
  font-weight: 900;
  line-height: 1.08;
}

h1 {
  font-size: clamp(2.5rem, 7vw, 5.8rem);
  max-width: 980px;
}

h2 {
  font-size: clamp(2rem, 4vw, 3.6rem);
}

h3 {
  font-size: clamp(1.25rem, 2vw, 1.65rem);
}

p {
  margin: 0 0 1rem;
  color: var(--color-muted);
}

ul,
ol {
  padding-left: 1.2rem;
}

.site-main a:not(.btn):focus-visible,
.site-footer a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid var(--color-accent);
  outline-offset: 3px;
}
--- src/scss/base/_forms.scss ---
.northstar-form, .newsletter-form, .search-form { display: grid; gap: 1rem; }
label { display: grid; gap: .4rem; font-weight: 800; color: var(--color-text); }
input, textarea { width: 100%; border: 1px solid var(--color-border-strong); border-radius: var(--radius); padding: .82rem .9rem; background: #fff; color: var(--color-text); }
textarea { resize: vertical; }
.form-note, .field-error { font-size: .9rem; }
.field-error { color: #b42318; margin: .2rem 0 0; }
.form-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
.search-form,
.northstar-form,
.newsletter-form {
  display: grid;
  gap: .85rem;
}

.search-form {
  grid-template-columns: 1fr auto;
}

label {
  display: grid;
  gap: .35rem;
  color: var(--color-text);
  font-weight: 800;
}

input,
textarea,
select {
  width: 100%;
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius);
  background: #fff;
  color: var(--color-text);
  padding: .82rem .9rem;
}

textarea {
  min-height: 150px;
  resize: vertical;
}

.field-error,
.form-status--error {
  color: #9a3412;
  font-weight: 800;
}

.form-status--success {
  color: #0f766e;
  font-weight: 800;
}

.honeypot,
.visually-hidden-field {
  position: absolute;
  left: -10000px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}
--- src/scss/base/_accessibility.scss ---
.screen-reader-text { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
.screen-reader-text:focus { clip: auto; width: auto; height: auto; z-index: 100000; background: #fff; color: #000; padding: .75rem 1rem; }
:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; } }
