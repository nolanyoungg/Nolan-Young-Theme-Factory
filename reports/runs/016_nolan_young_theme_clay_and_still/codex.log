+.material-list dt { border-top: 1px solid var(--line); padding-top: 13px; font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: var(--olive); }
+.material-list dd { margin: 4px 0 15px; }
+@media (max-width: 700px) { .collection-story { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 40px; } .collection-story:nth-child(even) figure { order: 0; } }
