+  background: var(--color-bg-soft);
+  color: var(--color-text);
+  font-weight: 800;
+  padding: .9rem 1rem;
+  text-align: left;
+  text-decoration: none;
+  overflow-wrap: anywhere;
+}
+
+@media (min-width: 960px) {
+  .primary-navigation {
+    display: flex;
+  }
+
+  .mobile-menu-toggle {
+    display: none;
+  }
+
+  .btn-header-cta {
+    display: inline-flex;
+  }
+}
+
+@media (max-width: 520px) {
