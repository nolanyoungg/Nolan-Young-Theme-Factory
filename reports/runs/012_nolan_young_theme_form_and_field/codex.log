ction-dark p,\r\n.section-dark dd,\r\n.section-dark li {\r\n  color: rgba(255, 255, 255, .78);\r\n}\r\n\r\n.eyebrow {\r\n  margin: 0 0 .7rem;\r\n  color: var(--color-secondary);\r\n  font-size: .78rem;\r\n  font-weight: 900;\r\n  letter-spacing: .08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.hero {\r\n  padding-block: clamp(4rem, 8vw, 8rem);\r\n  background: linear-gradient(180deg, #ffffff 0%, var(--color-bg-soft) 100%);\r\n}\r\n\r\n.hero__grid,\r\n.brand-statement,\r\n.single-service-highlight,\r\n.business-solution {\r\n  display: grid;\r\n  gap: clamp(1.5rem, 4vw, 4rem);\r\n  align-items: center;\r\n}\r\n\r\n.hero__summary,\r\n.trust-row,\r\n.stats-row {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\r\n  gap: .8rem;\r\n  margin-top: 1.5rem;\r\n}\r\n\r\n.hero__summary > *,\r\n.trust-row > *,\r\n.stats-row > * {\r\n  border: 1px solid var(--color-border);\r\n  border-radius: var(--radius);\r\n  background: #fff;\r\n  padding: 1rem;\r\n}\r\n\r\n.media-frame,\r\n.northstar-image {\r\n  display: block;\r\n  width: 100%;\r\n  border-radius: var(--radius-lg);\r\n  border: 1px solid var(--color-border);\r\n  background: var(--color-bg-soft);\r\n  box-shadow: var(--shadow);\r\n}\r\n\r\n.card-grid,\r\n.portfolio-grid,\r\n.blog-grid,\r\n.footer-widgets {\r\n  display: grid;\r\n  gap: 1rem;\r\n}\r\n\r\n.card-grid--three,\r\n.service-grid {\r\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\r\n}\r\n\r\n.info-card,\r\n.service-card,\r\n.portfolio-card,\r\n.blog-card,\r\n.work-card,\r\n.article-card,\r\n.package-card {\r\n  border: 1px solid var(--color-border);\r\n  border-radius: var(--radius);\r\n  background: #fff;\r\n  padding: clamp(1rem, 2vw, 1.4rem);\r\n  box-shadow: 0 8px 26px rgba(15, 23, 42, .06);\r\n}\r\n\r\n.info-card img,\r\n.service-card img,\r\n.portfolio-card img,\r\n.blog-card img,\r\n.work-card img,\r\n.article-card img {\r\n  width: 100%;\r\n  margin-bottom: 1rem;\r\n  border-radius: var(--radius);\