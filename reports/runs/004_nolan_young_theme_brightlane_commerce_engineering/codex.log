diff --git a/wp-content/themes/004_nolan_young_theme_brightlane_commerce_engineering/README.md b/wp-content/themes/004_nolan_young_theme_brightlane_commerce_engineering/README.md
index eb9752f44c67c36e38c47bb64a564852cb1f61f9..1a3d312cfc78183b414d88fdbab0408c6d74b222
--- a/wp-content/themes/004_nolan_young_theme_brightlane_commerce_engineering/README.md
